---
import { siteConfig } from "../config";
import Icono from "./Icono.astro";

const { nombre, iniciales, encabezado, bio, foto, cv, redes } = siteConfig;
---

<section id="inicio" class="border-b border-lila-borde/70">
  <div
    class="mx-auto grid max-w-6xl items-center gap-8 px-4 pt-10 pb-16 sm:px-6 md:grid-cols-[1fr_auto] md:gap-16 md:pt-20 md:pb-24"
  >
    <!-- Foto: espacio reservado hasta que exista siteConfig.foto -->
    <div class="md:order-2">
      {
        foto ? (
          <img
            src={foto}
            alt={`Foto de ${nombre}`}
            width="480"
            height="480"
            fetchpriority="high"
            class="size-28 rounded-full bg-lila object-cover ring-4 ring-lila sm:size-36 md:size-60"
          />
        ) : (
          <div
            role="img"
            aria-label={`Espacio reservado para la foto de ${nombre}`}
            class="flex size-28 items-center justify-center rounded-full border-2 border-dashed border-violeta/40 bg-lila text-3xl font-semibold text-violeta sm:size-36 md:size-60 md:text-6xl"
          >
            {iniciales}
          </div>
        )
      }
    </div>

    <div class="md:order-1">
      <h1 class="text-4xl font-bold tracking-tight text-balance text-tinta sm:text-5xl lg:text-6xl">
        {nombre}
      </h1>
      <p class="mt-4 text-lg font-medium text-violeta sm:text-xl">
        {encabezado}
      </p>
      <p class="mt-6 max-w-[62ch] text-base leading-relaxed text-tinta-suave sm:text-lg">
        {bio}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          cv && (
            <a
              href={cv}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-12 items-center gap-2 rounded-full bg-violeta px-6 font-semibold text-white transition-colors hover:bg-violeta-oscuro"
            >
              <Icono nombre="documento" />
              Ver CV
              <span class="sr-only"> (PDF, se abre en otra pestaña)</span>
            </a>
          )
        }
        <a
          href="#proyectos"
          class="inline-flex min-h-12 items-center gap-2 rounded-full border border-violeta/40 bg-white px-6 font-semibold text-violeta transition-colors hover:bg-lila"
        >
          <Icono nombre="abajo" />
          Ver proyectos
        </a>
      </div>

      <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-1" aria-label="Enlaces">
        {
          redes.github && (
            <li>
              <a
                href={redes.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 rounded-full px-2 font-medium text-tinta-suave transition-colors hover:text-violeta"
              >
                <Icono nombre="github" class="size-6" />
                GitHub
              </a>
            </li>
          )
        }
        {
          redes.linkedin && (
            <li>
              <a
                href={redes.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 rounded-full px-2 font-medium text-tinta-suave transition-colors hover:text-violeta"
              >
                <Icono nombre="linkedin" class="size-6" />
                LinkedIn
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>
