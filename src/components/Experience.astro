---
import { siteConfig } from "../config";
import TituloSeccion from "./TituloSeccion.astro";

const experiencia = siteConfig.experiencia;
---

{
  experiencia.length > 0 && (
    <section id="experiencia" class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <TituloSeccion titulo="Experiencia" />
        <div class="space-y-6">
          {experiencia.map((e) => (
            <article class="rounded-2xl border border-lila-borde bg-white p-5 sm:p-8">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <h3 class="text-xl font-bold text-tinta">{e.cargo}</h3>
                <p class="text-sm font-medium whitespace-nowrap text-tinta-suave">{e.periodo}</p>
              </div>
              <p class="mt-1 font-semibold text-violeta">{e.organizacion}</p>
              <ul class="mt-5 max-w-[70ch] space-y-3">
                {e.logros.map((l) => (
                  <li class="flex gap-3 leading-relaxed text-tinta-suave">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-violeta" aria-hidden="true" />
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
