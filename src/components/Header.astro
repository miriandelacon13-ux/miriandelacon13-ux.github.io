---
import { siteConfig } from "../config";

const hayProyectos = siteConfig.proyectos.length > 0;
const hayExperiencia = siteConfig.experiencia.length > 0;
const hayFormacion = siteConfig.formacion.length > 0;

const enlace =
  "inline-flex min-h-11 items-center rounded-full px-3 text-[0.95rem] font-medium text-tinta-suave transition-colors hover:bg-lila hover:text-violeta";
---

<header
  id="encabezado"
  class="sticky top-0 z-50 border-b border-transparent bg-fondo/90 backdrop-blur-md transition-colors"
>
  <nav
    aria-label="Principal"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-4 sm:px-6"
  >
    <a href="#inicio" class="min-h-11 inline-flex items-center font-semibold text-tinta hover:text-violeta">
      <span class="md:hidden">{siteConfig.nombreCorto}</span>
      <span class="hidden md:inline">{siteConfig.nombre}</span>
    </a>

    <ul class="flex items-center gap-0.5 sm:gap-1">
      {hayProyectos && <li><a href="#proyectos" class={enlace}>Proyectos</a></li>}
      {siteConfig.video && <li><a href="#video" class={enlace}>Video</a></li>}
      {hayExperiencia && <li class="hidden md:block"><a href="#experiencia" class={enlace}>Experiencia</a></li>}
      {hayFormacion && <li class="hidden md:block"><a href="#formacion" class={enlace}>Formación</a></li>}
      {
        siteConfig.cv && (
          <li class="ml-1">
            <a
              href={siteConfig.cv}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center rounded-full bg-violeta px-4 text-[0.95rem] font-semibold text-white transition-colors hover:bg-violeta-oscuro"
            >
              <span class="md:hidden">CV</span>
              <span class="hidden md:inline">Ver CV</span>
              <span class="sr-only"> (PDF, se abre en otra pestaña)</span>
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  // Borde inferior solo cuando hay contenido debajo del encabezado
  const encabezado = document.getElementById("encabezado");
  const actualizar = () => {
    const conScroll = window.scrollY > 8;
    encabezado?.classList.toggle("border-lila-borde", conScroll);
    encabezado?.classList.toggle("border-transparent", !conScroll);
  };
  window.addEventListener("scroll", actualizar, { passive: true });
  actualizar();
</script>
