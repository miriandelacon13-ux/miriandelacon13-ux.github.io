---
import { siteConfig, type Proyecto } from "../config";
import Icono from "./Icono.astro";
import TituloSeccion from "./TituloSeccion.astro";

const proyectos = siteConfig.proyectos;
const destacados = proyectos.filter((p) => p.destacado);
const otros = proyectos.filter((p) => !p.destacado && !p.materialDelCurso);
const material = proyectos.filter((p) => p.materialDelCurso);

// Imagen ancha (p. ej. un gráfico de barras): va arriba a todo el ancho. Vertical o cuadrada: panel lateral.
const esHorizontal = (p: Proyecto) => {
  const ref = p.imagen?.escritorio ?? p.imagen;
  return ref ? ref.ancho / ref.alto > 1.3 : false;
};

const boton =
  "inline-flex min-h-11 items-center gap-2 rounded-full border border-violeta/40 bg-white px-4 font-semibold text-violeta transition-colors hover:border-violeta hover:bg-violeta hover:text-white";
const etiqueta = "rounded-full border border-lila-borde px-3 py-1 text-sm text-tinta-suave";
const acceso =
  "inline-flex min-h-11 items-center rounded-full bg-lila px-4 text-[0.95rem] font-semibold text-violeta transition-colors hover:bg-violeta hover:text-white";
---

{
  proyectos.length > 0 && (
    <section id="proyectos" class="py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <TituloSeccion
          titulo="Proyectos"
          intro="Análisis de datos con fuentes públicas del Perú. Cada tarjeta resume la pregunta, el resultado y los enlaces al código."
        />

        <nav aria-label="Partes de Proyectos" class="-mt-4 mb-10 md:mb-12">
          <ul class="flex flex-wrap gap-2">
            <li><a href="#destacados" class={acceso}>Destacados ({destacados.length})</a></li>
            {otros.length > 0 && <li><a href="#todos-mis-proyectos" class={acceso}>Todos mis proyectos ({otros.length})</a></li>}
            {material.length > 0 && <li><a href="#material-del-curso" class={acceso}>Material del curso ({material.length})</a></li>}
          </ul>
        </nav>

        {/* ---------- Destacados ---------- */}
        <h3 id="destacados" class="sr-only">Proyectos destacados</h3>
        <div class="space-y-10">
          {destacados.map((p, i) => {
            const horizontal = esHorizontal(p);
            const imagenDerecha = !horizontal && i % 2 === 1;
            const imagen = p.imagen && (
              <div
                class:list={[
                  "border-lila-borde bg-lila/60 p-3 sm:p-5",
                  horizontal
                    ? "border-b sm:p-6"
                    : [
                        "border-b lg:flex lg:items-center lg:justify-center lg:border-b-0 lg:p-6",
                        imagenDerecha ? "lg:order-2 lg:border-l" : "lg:border-r",
                      ],
                ]}
              >
                <picture class="block w-full">
                  {p.imagen.escritorio && (
                    <source
                      media="(min-width: 1024px)"
                      srcset={p.imagen.escritorio.src}
                      width={p.imagen.escritorio.ancho}
                      height={p.imagen.escritorio.alto}
                    />
                  )}
                  <img
                    src={p.imagen.src}
                    alt={p.imagen.alt}
                    width={p.imagen.ancho}
                    height={p.imagen.alto}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "mx-auto h-auto w-full rounded-lg border border-lila-borde bg-white",
                      !horizontal && "lg:max-h-[46rem] lg:w-auto",
                    ]}
                  />
                </picture>
              </div>
            );
            const encabezado = (
              <div>
                <p class="mb-2 text-sm font-semibold tracking-wide text-violeta uppercase">Proyecto destacado</p>
                <h3 class="text-2xl font-bold tracking-tight text-balance text-tinta sm:text-[1.7rem] sm:leading-tight">
                  {p.titulo}
                </h3>
                <p class="mt-3 leading-relaxed text-tinta-suave">{p.resumen}</p>
              </div>
            );
            const pregunta = (
              <div>
                <dt class="text-sm font-semibold text-tinta">Pregunta</dt>
                <dd class="mt-1 leading-relaxed text-tinta-suave">{p.pregunta}</dd>
              </div>
            );
            const resultado = p.resultado && (
              <div class="rounded-xl bg-lila px-4 py-4 sm:px-5">
                <dt class="text-sm font-semibold text-tinta">Resultado</dt>
                <dd class="mt-1 leading-relaxed text-tinta">
                  <span class="text-2xl font-bold text-violeta">{p.resultado.cifra}</span>{" "}{p.resultado.texto}
                  {p.resultado.fuente && (
                    <span class="mt-2 block text-sm text-tinta-suave">Fuente: {p.resultado.fuente}</span>
                  )}
                </dd>
              </div>
            );
            const pie = (
              <>
                {p.etiquetas && p.etiquetas.length > 0 && (
                  <ul class="flex flex-wrap gap-2" aria-label="Herramientas">
                    {p.etiquetas.map((e) => (
                      <li class={etiqueta}>{e}</li>
                    ))}
                  </ul>
                )}
                <ul class="flex flex-wrap gap-2 sm:gap-3" aria-label={`Enlaces de ${p.titulo}`}>
                  {p.enlaces.map((e) => (
                    <li>
                      <a href={e.url} target="_blank" rel="noopener noreferrer" class={boton}>
                        <Icono nombre={e.icono} />
                        {e.etiqueta}
                        <span class="sr-only"> (se abre en otra pestaña)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            );

            return horizontal ? (
              <article class="overflow-hidden rounded-2xl border border-lila-borde bg-white shadow-[0_1px_2px_rgba(34,27,43,0.04)]">
                {imagen}
                <div class="grid gap-6 p-5 sm:p-8 lg:grid-cols-2 lg:gap-10">
                  <div class="flex flex-col gap-5">
                    {encabezado}
                    <dl>{pregunta}</dl>
                  </div>
                  <div class="flex flex-col gap-5">
                    <dl>{resultado}</dl>
                    {pie}
                  </div>
                </div>
              </article>
            ) : (
              <article
                class:list={[
                  "overflow-hidden rounded-2xl border border-lila-borde bg-white shadow-[0_1px_2px_rgba(34,27,43,0.04)] lg:grid",
                  imagenDerecha ? "lg:grid-cols-[1fr_1.05fr]" : "lg:grid-cols-[1.05fr_1fr]",
                ]}
              >
                {imagen}
                <div class="flex flex-col gap-5 p-5 sm:p-8">
                  {encabezado}
                  <dl class="space-y-4">
                    {pregunta}
                    {resultado}
                  </dl>
                  {pie}
                </div>
              </article>
            );
          })}
        </div>

        {/* ---------- Todos mis proyectos ---------- */}
        {otros.length > 0 && (
          <div class="mt-16 md:mt-20">
            <h3 id="todos-mis-proyectos" class="text-2xl font-bold tracking-tight text-tinta md:text-3xl">Todos mis proyectos</h3>
            <p class="mt-3 max-w-[62ch] leading-relaxed text-tinta-suave">
              El resto de mis repositorios públicos, con una descripción breve y el enlace al código.
            </p>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {otros.map((p) => (
                <article class="flex flex-col overflow-hidden rounded-2xl border border-lila-borde bg-white">
                  {p.imagen && (
                    <div class="border-b border-lila-borde bg-lila/60 p-3">
                      <img
                        src={p.imagen.src}
                        alt={p.imagen.alt}
                        width={p.imagen.ancho}
                        height={p.imagen.alto}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/9] w-full rounded-md border border-lila-borde bg-white object-contain"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
                    <h4 class="text-xl font-bold tracking-tight text-balance text-tinta">{p.titulo}</h4>
                    {p.procedencia && (
                      <p class="w-fit rounded-full bg-lila px-3 py-1 text-sm font-semibold text-violeta">{p.procedencia}</p>
                    )}
                    <p class="leading-relaxed text-tinta-suave">{p.resumen}</p>
                    <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label={`Enlaces de ${p.titulo}`}>
                      {p.enlaces.map((e) => (
                        <li>
                          <a href={e.url} target="_blank" rel="noopener noreferrer" class={boton}>
                            <Icono nombre={e.icono} />
                            {e.etiqueta}
                            <span class="sr-only"> (se abre en otra pestaña)</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {/* ---------- Material del curso ---------- */}
        {material.length > 0 && (
          <div class="mt-16 md:mt-20">
            <h3 id="material-del-curso" class="text-2xl font-bold tracking-tight text-tinta md:text-3xl">Material del curso</h3>
            <p class="mt-3 max-w-[62ch] leading-relaxed text-tinta-suave">
              Repositorios que copié para seguir las clases. No son proyectos propios: indico de dónde vienen.
            </p>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {material.map((p) => (
                <article class="flex flex-col overflow-hidden rounded-2xl border border-lila-borde bg-white">
                  {p.imagen && (
                    <div class="border-b border-lila-borde bg-lila/60 p-3">
                      <img
                        src={p.imagen.src}
                        alt={p.imagen.alt}
                        width={p.imagen.ancho}
                        height={p.imagen.alto}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/9] w-full rounded-md border border-lila-borde bg-white object-contain"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
                    <h4 class="text-xl font-bold tracking-tight text-balance text-tinta">{p.titulo}</h4>
                    {p.procedencia && (
                      <p class="w-fit rounded-full bg-lila px-3 py-1 text-sm font-semibold text-violeta">{p.procedencia}</p>
                    )}
                    <p class="leading-relaxed text-tinta-suave">{p.resumen}</p>
                    <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label={`Enlaces de ${p.titulo}`}>
                      {p.enlaces.map((e) => (
                        <li>
                          <a href={e.url} target="_blank" rel="noopener noreferrer" class={boton}>
                            <Icono nombre={e.icono} />
                            {e.etiqueta}
                            <span class="sr-only"> (se abre en otra pestaña)</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        <p class="mt-10">
          <a
            href={`${siteConfig.redes.github}?tab=repositories`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 font-semibold text-violeta underline-offset-4 hover:underline"
          >
            <Icono nombre="github" />
            Ver todos mis repositorios en GitHub
            <span class="sr-only"> (se abre en otra pestaña)</span>
          </a>
        </p>
      </div>
    </section>
  )
}
